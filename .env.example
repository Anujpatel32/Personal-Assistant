# MEOW Personal Assistant - Environment Variables (Example)
# Copy this file to .env and fill in your API keys
# DO NOT commit the .env file!

# LLM Provider API Keys (configure at least one)
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=

# Text-to-Speech (optional)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Weather (optional)
WEATHER_CITY=Pune
