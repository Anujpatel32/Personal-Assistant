# ─────────────────────────────────────────────────────────────────────
# MEOW Personal Assistant — Environment Variables
# ─────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values you need.
# DO NOT commit the .env file!
#
# Priority: env vars (from .env) override memory.json values.
# If a key is blank here, MEOW falls back to whatever is in memory.json.
# ─────────────────────────────────────────────────────────────────────

# ── LLM Provider API Keys (configure at least one) ──────────────────
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=

# ── Text-to-Speech ──────────────────────────────────────────────────
# ElevenLabs (optional cloud TTS)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Kokoro (optional local TTS)
KOKORO_VOICE=af_sarah

# ── Model & TTS Selection ──────────────────────────────────────────
# Which LLM backend to use: gemini | groq | nvidia | openrouter | llama
SELECTED_MODEL=gemini

# Which TTS engine to use: sapi | elevenlabs | kokoro | gtts
SELECTED_TTS=sapi

# ── Assistant Behaviour ─────────────────────────────────────────────
# Wake word for voice activation
WAKE_WORD=mark

# Default city for weather lookups
WEATHER_CITY=Pune

# Avatar style: 3d_hologram | 2d | minimal
AVATAR_TYPE=3d_hologram

# Voice personality style: casual | formal | playful
VOICE_STYLE=casual

# ── Directories & Paths ────────────────────────────────────────────
# Relative to the project root, or use absolute paths.
# DATA_DIR=.
# LOG_DIR=logs
# DB_FILENAME=meow.db
